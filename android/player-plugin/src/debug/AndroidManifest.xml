<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hand tracking declarations come from the selected OpenXR vendor export
         preset in both Debug and Release; this shared AAR is platform neutral. -->
    <application>
        <provider android:name="org.vrpassthroughplayer.plugin.LocalAccessTestProvider"
            android:authorities="${applicationId}.accessfixture" android:exported="false" />
        <activity android:name="org.vrpassthroughplayer.plugin.MpvDiagnosticActivity"
            android:exported="true" android:permission="android.permission.DUMP" android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <receiver android:name="org.vrpassthroughplayer.plugin.DebugDiagnosticsReceiver"
            android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="${applicationId}.DEBUG_PHOTO_PORTRAIT" />
                <action android:name="${applicationId}.DEBUG_RVM_STANDALONE" />
                <action android:name="${applicationId}.DEBUG_RVM" />
                <action android:name="${applicationId}.DEBUG_DLNA" />
                <action android:name="${applicationId}.DEBUG_PLEX_NETWORK" />
                <action android:name="${applicationId}.DEBUG_CLOUD" />
                <action android:name="${applicationId}.DEBUG_DEPTH_BENCH" />
                <action android:name="${applicationId}.DEBUG_MPV_CORE" />
                <action android:name="${applicationId}.DEBUG_MPV_DOLBY" />
                <action android:name="${applicationId}.DEBUG_MPV_GPU" />
                <action android:name="${applicationId}.DEBUG_MPV_SOURCE" />
                <action android:name="${applicationId}.DEBUG_PLAYER_MPV" />
                <action android:name="${applicationId}.DEBUG_SMB_CRYPTO" />
                <action android:name="${applicationId}.DEBUG_MPV_SHARED" />
                <action android:name="${applicationId}.DEBUG_MPV_AUDIO" />
                <action android:name="${applicationId}.DEBUG_MPV_MOTION" />
                <action android:name="${applicationId}.DEBUG_CONTROLLED" />
                <action android:name="${applicationId}.DEBUG_RVM_VIDEO" />
                <action android:name="${applicationId}.DEBUG_CANCEL_CONTROLLED" />
                <action android:name="${applicationId}.DEBUG_LAUNCH" />
                <action android:name="${applicationId}.DEBUG_LAUNCH_2D" />
                <action android:name="${applicationId}.DEBUG_LOCAL_ACCESS" />
                <action android:name="${applicationId}.DEBUG_LOCAL_SELECTION" />
                <action android:name="${applicationId}.DEBUG_MPV_URI" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

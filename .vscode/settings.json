{
  "cmake.useCMakePresets": "always",
  "search.exclude": {
    "thirdparty/": true
  },
  "C_Cpp.intelliSenseEngine": "default",
  "clangd.arguments": [
    "--background-index",
    "--completion-style=detailed",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--suggest-missing-includes"
  ],
  "clangd.fallbackFlags": [
    "-std=c++20"
  ],
  "files.associations": {
    "*.jsonc.in": "jsonc",
    "*.plist.in": "xml",
    "*.qrc": "xml",
    "*.qrc.in": "xml",
    "*.rc.in": "text",
    "*.wxs.in": "xml"
  },
}
